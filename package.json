{
    "name": "@ostro/foundation",
    "version": "2.0.0-alpha.4",
    "description": "Foundation for OstroJS",
    "main": "application.js",
    "exports": {
        ".": {
            "types": "./.typed/application.d.ts",
            "default": "./application.js"
        },
        "./*": {
            "types": "./.typed/*.d.ts",
            "default": "./*.js"
        }
    },
    "scripts": {
        "test": "jest",
        "build": "npm run lint:check && rm -rf build && ostro-build --prepare",
        "prepublishOnly": "npm run build",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit"
    },
    "dependencies": {
        "@ostro/auth": "^2.0.0-alpha.4",
        "@ostro/cache": "^2.0.0-alpha.3",
        "@ostro/config": "^2.0.0-alpha.3",
        "@ostro/console": "^2.0.0-alpha.3",
        "@ostro/container": "^2.0.0-alpha.3",
        "@ostro/contracts": "^2.0.0-alpha.3",
        "@ostro/database": "^2.0.0-alpha.6",
        "@ostro/filesystem": "^2.0.0-alpha.3",
        "@ostro/http": "^2.0.0-alpha.3",
        "@ostro/logger": "^2.0.0-alpha.3",
        "@ostro/router": "^2.0.0-alpha.4",
        "@ostro/server": "^2.0.0-alpha.3",
        "@ostro/session": "^2.0.0-alpha.3",
        "@ostro/support": "^2.0.0-alpha.3",
        "@ostro/validation": "^2.0.0-alpha.3",
        "csrf": "^3.1.0",
        "dotenv": "^16.4.7",
        "fs-extra": "^11.4.1",
        "lodash.get": "^4.4.2",
        "ouch": "^2.0.1",
        "serve-static": "^1.16.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "foundation"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/foundation.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/foundation/issues"
    },
    "homepage": "https://github.com/ostrojs/foundation#readme",
    "types": ".typed/application.d.ts",
    "devDependencies": {
        "@ostro/builder": "^2.0.0-alpha.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
